rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /siteData/{document} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email in [
                     'natty09@gmail.com',
                     'nyachyo29@gmail.com',
                     'rnskrns@gmail.com'
                   ];
    }
  }
}
