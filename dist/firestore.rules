rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email in [
               'natty09@gmail.com',
               'nyachyo29@gmail.com',
               'rnskrns@gmail.com'
             ];
    }

    match /siteData/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
